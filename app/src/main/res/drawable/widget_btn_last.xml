<?xml version="1.0" encoding="utf-8"?>
<!-- The Last mark on a widget button: the breast used last, outlined in the feed colour. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/widget_surface" />
    <stroke android:width="@dimen/widget_outline" android:color="@color/widget_feed" />
    <corners android:radius="@dimen/widget_button_radius" />
</shape>
