<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- No INTERNET permission here: the play build has none. Only the github build adds it, for
         self-update (src/github/AndroidManifest.xml). The baby's data never leaves the phone. -->

    <!-- The live notification (docs/notifications.md): asleep or awake, the timeline bar, running
         timers. Android 13+ asks the person first. Both builds; app/build.gradle.kts allows it. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".CochiloApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Cochilo">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- The notification's buttons and its tick; only the app's own PendingIntents reach it. -->
        <receiver
            android:name=".notify.NotificationActions"
            android:exported="false" />
        <!-- The quick-settings tile (docs/flows.md): Start sleep / Woke up from the shade. The
             permission here guards the service (only the system may bind it); it isn't one the
             app asks for. -->
        <service
            android:name=".tile.SleepTile"
            android:exported="true"
            android:icon="@drawable/gg_ic_moon"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <!-- The home-screen widget (docs/widget.md). Exported only for the launcher's update
             broadcast; its buttons go to NotificationActions, which is not exported. -->
        <receiver
            android:name=".widget.CochiloWidget"
            android:exported="true"
            android:label="@string/widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info" />
        </receiver>
    </application>
</manifest>
