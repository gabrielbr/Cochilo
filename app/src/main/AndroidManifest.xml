<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- No INTERNET permission here: the play build has none. Only the github build adds it, for
         self-update (src/github/AndroidManifest.xml). The baby's data never leaves the phone. -->

    <!-- The live notification (docs/notifications.md): asleep or awake, the timeline bar, running
         timers. Android 13+ asks the person first. Both builds; app/build.gradle.kts allows it. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".CochiloApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Cochilo">
        <!-- singleTask: a file shared from another app (Napper's export) opens Cochilo in its own task,
             not inside the other app's, and reaches the running app through onNewIntent. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Share to Cochilo (docs/backup.md, 0.41.0): a Napper CSV or a Cochilo backup from any app's
                 share sheet is imported at once, with the same merge as Settings › Import (never deletes).
                 Reading a shared file needs no permission: the sender grants it for this one file. -->
            <intent-filter android:label="@string/share_import_label">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/csv" />
                <data android:mimeType="text/comma-separated-values" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="application/csv" />
                <data android:mimeType="application/json" />
                <data android:mimeType="application/vnd.ms-excel" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
            <!-- "Open with Cochilo" from a file manager or a downloads list: the same import. -->
            <intent-filter android:label="@string/share_import_label">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="text/csv" />
                <data android:mimeType="text/comma-separated-values" />
                <data android:mimeType="application/csv" />
                <data android:mimeType="application/json" />
                <data android:mimeType="application/vnd.ms-excel" />
            </intent-filter>
        </activity>
        <!-- The notification's buttons and its tick; only the app's own PendingIntents reach it. -->
        <receiver
            android:name=".notify.NotificationActions"
            android:exported="false" />
        <!-- The quick-settings tile (docs/flows.md): Start sleep / Woke up from the shade. The
             permission here guards the service (only the system may bind it); it isn't one the
             app asks for. -->
        <service
            android:name=".tile.SleepTile"
            android:exported="true"
            android:icon="@drawable/gg_ic_moon"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <!-- The home-screen widget (docs/widget.md). Exported only for the launcher's update
             broadcast; its buttons go to NotificationActions, which is not exported. -->
        <receiver
            android:name=".widget.CochiloWidget"
            android:exported="true"
            android:label="@string/widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info" />
        </receiver>
        <!-- The watch tile (0.53.0, docs/wear.md): messages from Cochilo's own watch app. Google's
             wearable services require it exported; it reads only Cochilo's /cochilo paths, and
             the phone answers only a watch connected directly. -->
        <service
            android:name=".wear.WearListener"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data android:scheme="wear" android:host="*" android:pathPrefix="/cochilo" />
            </intent-filter>
        </service>
    </application>
</manifest>
