<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      The github (family) build updates itself from GitHub releases, the design system's
      self-update: one unauthenticated request to GitHub's public releases API and the download of
      the new APK; also Ask Cochilo's model download (0.37.0). Since 0.47.0 INTERNET also opens the
      socket for partner sync, on the home Wi-Fi only, sealed (docs/sync.md). The baby's data never
      leaves the home.
      REQUEST_INSTALL_PACKAGES lets Android show "Do you want to update this app?".
      FOREGROUND_SERVICE (and its special-use type, Android 14+) lets partner sync keep answering
      with Cochilo closed, when the parent turns that on (0.52.0, docs/sync.md). It wears the live
      notification; it never reaches the internet.
      The play build has none of these; app/build.gradle.kts checks both lists on every build.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <application>
        <service
            android:name=".sync.SyncService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Two parents' phones keep one baby log in step over the home Wi-Fi, peer to peer, while the app is closed. Opt-in." />
        </service>
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updates"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/update_paths" />
        </provider>
    </application>
</manifest>
