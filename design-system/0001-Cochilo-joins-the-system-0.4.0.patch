+    o = [f"// {HEADER.format(v=t['version'])}", "package br.gabriel.cochilo.ui.theme", "",
+         "import androidx.compose.ui.graphics.Color", "import androidx.compose.ui.unit.dp", "",
+         "/**",
+         " * Gabriel Design System values for Cochilo. Screens read colours through CochiloTheme.colors,",
+         " * which picks Light or Dark; sizes are dp, type sizes sp, durations ms.",
+         " */",
+         "object CTokens {",
+         "    /** One theme's colours. Every name exists in both themes. */",
+         "    class Palette(",
+         ]
+    names = list(colours)
+    o += [f"        val {camel(n)}: Color," for n in names]
+    o += ["    )", ""]
+    for th in layer["themes"]:
+        o += [f"    val {th.capitalize()} = Palette("]
+        for n in names:
+            o += [f"        {camel(n)} = Color({argb(colours[n][th])}), // {usage[n]}"]
+        o += ["    )", ""]
+    o += ["    object Spacing {"]
+    o += [f"        val {camel(tok['name'])} = {num(tok['value'])}.dp" for tok in r["spacing"]]
+    o += ["    }", "", "    object Radius {"]
+    o += [f"        val {camel(tok['name'])} = {num(tok['value'])}.dp" for tok in r["radius"]]
+    o += ["    }", "", "    object Size {"]
+    o += [f"        val {camel(tok['name'])} = {num(tok['value'])}.dp" for tok in r["size"]]
+    o += ["    }", "", "    /** Durations in ms. */", "    object Motion {"]
+    o += [f"        const val {camel(tok['name'])} = {num(tok['value'])}" for tok in r["motion"]]
+    o += ["    }", "", "    /** Font size and line height in sp, letter spacing in sp. */", "    object Type {"]
+    for group in layer["type"]:
+        for st in group["styles"]:
+            n = camel(st["name"])
+            o += [f"        const val {n}Size = {num(st['fontSize'])}",
+                  f"        const val {n}Line = {num(st['lineHeight'])}",
+                  f"        const val {n}Bold = {str(int(st.get('fontWeight', 400)) >= 700).lower()}"]
+            if "letterSpacing" in st:
+                o += [f"        const val {n}Tracking = {float(num(st['letterSpacing']))}f"]
+            if st.get("textTransform") == "uppercase":
+                o += [f"        const val {n}Caps = true"]
+    o += ["    }", "}"]
+    return "\n".join(o) + "\n"
