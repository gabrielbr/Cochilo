{
  "$description": "Proposed 'tata' layer for the Gabriel Design System: Cochilo themed as a Tatá Slings product. Draft 0.1, 2026-11-02. Not generated, not used by the app yet; see docs/tata-slings/design-system.md.",
  "layer": "tata",
  "extends": "cochilo",
  "color": {
    "light": {
      "page":        { "value": "#FBF7F2", "note": "Pérola. Screen background." },
      "surface":     { "value": "#FFFFFF", "note": "Cards, header, sheets, fields." },
      "ink":         { "value": "#13293D", "note": "Navy from the site accent. 13.9:1 on page." },
      "muted":       { "value": "#5F6B78", "note": "Meta text. 5.1:1 on page." },
      "line":        { "value": "#E9E2D8", "note": "Hairlines. Never text." },
      "teal":        { "value": "#5DC2BB", "note": "Brand teal from the logo. The one primary action, frame, active tab. Fill only.", "replaces": "mint" },
      "onTeal":      { "value": "#13293D", "note": "Text on teal. 7.0:1.", "replaces": "onMint" },
      "tealText":    { "value": "#1E6E68", "note": "Teal as text. 5.7:1 on page." },
      "tealSoft":    { "value": "#DFF3F1", "note": "Selected chips, tip cards. ink 12.9:1, tealText 5.2:1." },
      "cereja":      { "value": "#E07A6B", "note": "Stop/destructive fill; text on it is ink (5.1:1).", "replaces": "coral" },
      "cerejaText":  { "value": "#B5473A", "note": "Error text. 5.0:1 on page, 4.6:1 on cerejaSoft.", "replaces": "coralText" },
      "cerejaSoft":  { "value": "#FBE9E5", "replaces": "coralSoft" },
      "panel":       { "value": "#13293D", "note": "Sleep panel: navy night." },
      "onPanel":     { "value": "#FBF7F2", "note": "13.9:1 on panel." },
      "onPanelMuted":{ "value": "#A3B0BC" },
      "snackbar":    { "value": "#13293D" },
      "snackbarAction": { "value": "#5DC2BB" },
      "eventCarry":  { "value": "#1E8C84", "note": "New data colour: naps in the sling or in arms. Graphic, 3.8:1 on page." }
    },
    "dark": {
      "page":        { "value": "#10161C" },
      "surface":     { "value": "#171D24" },
      "ink":         { "value": "#EDF1F4", "note": "14.9:1 on surface." },
