      "line":        { "value": "#26303A" },
      "teal":        { "value": "#5DC2BB" },
      "onTeal":      { "value": "#10161C", "note": "8.6:1." },
      "tealText":    { "value": "#7FD6CF", "note": "10.0:1 on surface." },
      "tealSoft":    { "value": "#173A38" },
      "cereja":      { "value": "#FF9C8E" },
      "cerejaText":  { "value": "#FF9C8E", "note": "8.4:1 on surface." },
      "cerejaSoft":  { "value": "#3A2220" },
      "panel":       { "value": "#0B1A27" },
      "onPanel":     { "value": "#EDF1F4" },
      "onPanelMuted":{ "value": "#A3B0BC" },
      "snackbar":    { "value": "#EDF1F4" },
      "snackbarAction": { "value": "#1E6E68" },
      "eventCarry":  { "value": "#5DC2BB" }
    },
    "fabric": {
      "perola": "#FBF7F2", "mel": "#D9A441", "capuccino": "#B08B6E", "chocolate": "#5B3E31",
      "rosaCha": "#E8B4A8", "cereja": "#B8323F", "trevo": "#6E9C7A", "imensidao": "#2F5D8A",
      "lavanda": "#B7A6D6", "chumbo": "#4A4F55",
