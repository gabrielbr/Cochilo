  },
  "radius": { "s": 8, "m": 12, "l": 20, "round": 999 },
  "texture": {
    "trama": { "angle": 45, "lineWidth": 1, "pitch": 4, "color": "teal", "opacity": 0.25, "note": "Woven hatching from the logo. Never behind text." }
  }
